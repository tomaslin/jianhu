config_version=5

[application]
config/name="Dreaming of Jianghu"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A touch-first ink-wash physics roguelike with eight distinct Jianghu worlds."

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[physics]
common/physics_ticks_per_second=60
2d/default_gravity=660.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.965, 0.95, 0.91, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false

[audio]
buses/default_bus_layout="res://default_bus_layout.tres"

